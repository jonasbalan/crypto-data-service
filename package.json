{
  "name": "crypto-data-service",
  "version": "1.0.0",
  "description": "Serviço de coleta e análise de dados do mercado crypto utilizando IA",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "tsc --skipLibCheck && webpack --mode production",
    "build:backend": "tsc --skipLibCheck",
    "build:frontend": "webpack --mode production",
    "dev:frontend": "webpack serve --mode development",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:frontend\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "migrate": "ts-node src/database/migrations/index.ts",
    "start:ollama": "docker-compose up -d ollama redis",
    "pull:model": "curl -X POST http://localhost:11434/api/pull -d '{\"name\":\"llama3\"}'"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "@pinecone-database/pinecone": "^1.1.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@zilliz/milvus2-sdk-node": "^2.5.9",
    "axios": "^1.9.0",
    "chart.js": "^4.4.9",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "ml-matrix": "^6.12.1",
    "ml-regression": "^5.0.0",
    "ml-stat": "^1.3.3",
    "mongoose": "^8.15.0",
    "morgan": "^1.10.0",
    "prom-client": "^15.1.0",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "socket.io": "^4.7.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "winston": "^3.11.0",
    "ws": "^8.14.2"
