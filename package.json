    "@types/node": "^20.10.4",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/sinon": "^17.0.4",
    "@types/supertest": "^2.0.16",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "concurrently": "^9.1.2",
    "css-loader": "^7.1.2",
    "eslint": "^8.55.0",
