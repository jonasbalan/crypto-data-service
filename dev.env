# Configurações do Servidor
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
API_KEY=dev-api-key

# Bancos de Dados (apontando para localhost onde os containers rodam)
MONGODB_URI=mongodb://localhost:27017/crypto-data
REDIS_URL=redis://localhost:6379

# Pinecone (Banco de Dados Vetorial) - opcional
PINECONE_API_KEY=sua-chave-api-pinecone
PINECONE_INDEX=crypto-vectors

# APIs Externas
COINGECKO_API_KEY=sua-chave-api-coingecko

# Serviço de Embeddings
# Use 'openai' ou 'ollama'
EMBEDDING_SERVICE=ollama

# OpenAI (caso use EMBEDDING_SERVICE=openai)
OPENAI_API_KEY=sua-api-key-aqui

# Ollama (caso use EMBEDDING_SERVICE=ollama)
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3

# Milvus (apontando para localhost onde o container roda)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USERNAME=root
MILVUS_PASSWORD=Milvus
MILVUS_COLLECTION=crypto_vectors
MILVUS_DIMENSION=1536
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE
MILVUS_NLIST=1024

# Redis (apontando para localhost onde o container roda)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Desenvolvimento
SKIP_DATABASE_CONNECTION=false
HOT_RELOAD=true
WEBPACK_DEV_SERVER=true 